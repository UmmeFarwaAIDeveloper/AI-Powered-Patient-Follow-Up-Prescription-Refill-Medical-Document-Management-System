    {
      "parameters": {
        "promptType": "define",
        "text": "=Assess this prescription refill request.\nMedication: {{ $json.medication }}\nDosage: {{ $json.dosage }}\nPatient notes: {{ $json.patient_notes }}\nClassify as one of: urgent (patient is out of or nearly out of a critical medication such as insulin, anticoagulant, heart, seizure or asthma medicine, or reports worrying symptoms), review (controlled substance such as opioid, benzodiazepine or stimulant, too-early refill, or unclear request), routine (standard refill of a maintenance medication).\nReply in exactly this format: <level>|<one sentence summary for clinic staff>",
        "messages": {
          "messageValues": [
            {
              "message": "You are a clinical pharmacy triage assistant. You never approve or deny a refill. You only classify risk and summarise. When unsure, choose the more cautious level."
            }
          ]
        },
        "batching": {}
      },
