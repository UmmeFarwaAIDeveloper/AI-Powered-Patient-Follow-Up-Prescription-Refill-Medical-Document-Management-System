              "type": "string"
            },
            {
              "id": "r8",
              "name": "risk_level",
              "value": "={{ (() => { const t = String($json.text || \"\").split(\"|\")[0].toLowerCase(); return t.includes(\"urgent\") ? \"urgent\" : (t.includes(\"routine\") ? \"routine\" : \"review\"); })() }}",
